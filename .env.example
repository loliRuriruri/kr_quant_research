# OpenDART 인증키 (https://opendart.fss.or.kr 회원가입 후 발급)
OPENDART_API_KEY=

# KRX Open API 인증키 (https://openapi.krx.co.kr 회원가입 후 서비스별 이용신청)
KRX_API_KEY=

# 선택: 요청 간 대기(초). OpenDART 일일 한도를 보호한다.
OPENDART_SLEEP_SEC=0.15

# AI 분석 시에만 호출. 기본값은 Grok.
LLM_PROVIDER=xai
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
OPENCODE_GO_API_KEY=
# LLM_MODEL=
# Tier1 메뉴 브리핑 체인 (비우면 기본값: 일상 Nemotron:free→Flash, 분석 Grok→Pro)
# TIER1_ROUTINE_PROVIDER=openrouter
# TIER1_ROUTINE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# TIER1_ROUTINE_PAID_PROVIDER=openrouter
# TIER1_ROUTINE_PAID_MODEL=deepseek/deepseek-v4-flash-0731
# TIER1_ANALYSIS_PROVIDER=xai
# TIER1_ANALYSIS_MODEL=grok-4.6
# TIER1_ANALYSIS_PRO_PROVIDER=openrouter
# TIER1_ANALYSIS_PRO_MODEL=deepseek/deepseek-v4-pro-0813

# 선택: 한국투자증권 Open API (시세·상태 보조)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# 선택: 네이버 검색 API (뉴스·웹문서). NAVER API HUB 권장.
# https://www.ncloud.com/product/applicationService/naverApiHub
# 헤더: X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 선택: 네이버 지도(본사 위치). API HUB와 다른 애플리케이션 키입니다.
# Geocoding / Static Map 사용 설정 필요
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# 선택: 토스증권 Open API (시세·랭킹·수급). 주문은 사용하지 않음.
# WTS 설정 > Open API 에서 허용 IP를 등록해야 합니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 선택: FRED 거시지표 (리서치 맥락 전용, Quant 점수에 넣지 않음)
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 선택: 한국은행 ECOS. 비우면 공개 데모 키 sample (호출당 10행)
# https://ecos.bok.or.kr/api
BOK_ECOS_API_KEY=

# 선택: 텔레그램 알림 (스크리닝 완료·리포트 발간·작업 실패). 주문 없음.
# BotFather에서 봇 생성 후, 봇에게 아무 메시지나 보내고 채팅 ID를 넣습니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 선택: 프로젝트 루트 기본값은 이 파일이 있는 디렉터리
# STOCK_SCREENER_HOME=
